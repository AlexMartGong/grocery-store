# VentaCore (grocery-store) — environment template for Docker Compose.
# Copy to `.env` and fill real values. Never commit `.env`.

# ── Database (PostgreSQL) ───────────────────────────────────────────────────
# Compose passes the same values to both the `db` and `app` containers,
# so the app always connects to the DB the container created.
DB_NAME=grocerystore
DB_USERNAME=postgres
DB_PASSWORD=changeme

# ── Security / JWT ──────────────────────────────────────────────────────────
# REQUIRED — boot fails without it. Base64-encoded, must decode to >=32 bytes
# for HS256. Generate: openssl rand -base64 48
JWT_SECRET=Y2hhbmdlLW1lLWNoYW5nZS1tZS1jaGFuZ2UtbWUtY2hhbmdlLW1lLTEyMzQ1Ng==
# Token lifetime in minutes (default 480 = 8h)
JWT_EXPIRATION_MINUTES=480

# ── Print-agent bridge ──────────────────────────────────────────────────────
# Shared static key for PUT /api/v1/agent/stations/{id}/url (X-Agent-Key header)
AGENT_API_KEY=default-agent-secret

# ── Evolution API (WhatsApp notifications) ──────────────────────────────────
EVOLUTION_BASE_URL=http://localhost:8081
EVOLUTION_APIKEY=change_me
EVOLUTION_INSTANCE=pos-instance

# ── Telegram (admin alerts) ─────────────────────────────────────────────────
# Empty token => Telegram sends are a no-op
TELEGRAM_BOT_TOKEN=

# ── Cloudflare R2 (product-image storage) ───────────────────────────────────
# Empty credentials do not fail boot — image uploads fail at request time
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ventacore-products
R2_PUBLIC_URL=

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated frontend origins (empty => application.properties dev defaults)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://localhost:5174,http://192.168.68.69:5173
